NODE_ENV=development

JWT_SECRET=your_secure_jwt_secret_here
PORT=3000
ADMIN_PHONE=+23278952429
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_OTP_TEMPLATE_NAME=your_approved_otp_template_name
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# Monime payment integration
MONIME_ACCESS_TOKEN=your_monime_access_token
MONIME_SPACE_ID=spc-your_monime_space_id
MONIME_WEBHOOK_SECRET=your_monime_webhook_secret
APP_BASE_URL=http://localhost:3000

# Purchase receipt email (SMTP). Receipts are skipped if SMTP_USER/SMTP_PASS are not set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="JerseyHub <your_smtp_user@gmail.com>"

# Supabase server credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key


# Private admin page path (default is set in server.js; change to rotate the URL)
# ADMIN_PATH=admin-yourSecretSlug
